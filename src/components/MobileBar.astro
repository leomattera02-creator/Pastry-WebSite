---
import type { SiteConfig } from '../config/types';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const waLink = `https://wa.me/${config.contact.whatsapp.replace(/[^0-9]/g, '')}`;
const telLink = `tel:${config.contact.telefono.replace(/\s/g, '')}`;
---

<div
  class="fixed inset-x-0 bottom-0 z-40 flex md:hidden"
  aria-label="Azioni rapide"
  data-mobile-bar
  style="padding-bottom:env(safe-area-inset-bottom);"
>
  <a
    href={waLink}
    target="_blank"
    rel="noopener"
    class="flex flex-1 items-center justify-center gap-2 bg-[var(--color-accent)] py-3.5 text-sm font-medium text-[var(--color-accent-fg)]"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24s8.24 3.7 8.24 8.24-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.02-.38-1.95-1.2-.72-.64-1.21-1.43-1.35-1.68-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/>
    </svg>
    WhatsApp
  </a>
  <a
    href={telLink}
    class="flex flex-1 items-center justify-center gap-2 border-l border-[var(--color-accent-fg)]/20 bg-[var(--color-primary)] py-3.5 text-sm font-medium text-[var(--color-primary-fg)]"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    Chiama
  </a>
</div>

<style>
  body:has([data-mobile-bar]) {
    padding-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    body:has([data-mobile-bar]) {
      padding-bottom: 0;
    }
  }
</style>
