---
import type { SiteConfig } from '../config/types';

const { config } = Astro.props;

const dayLabels: Record<string, string> = {
  lunedi: 'Lunedì',
  martedi: 'Martedì',
  mercoledi: 'Mercoledì',
  giovedi: 'Giovedì',
  venerdi: 'Venerdì',
  sabato: 'Sabato',
  domenica: 'Domenica',
};

const socialLabels: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  pinterest: 'Pinterest',
};

const socials = Object.entries(config.socials).filter(
  ([, v]) => v,
);

const waLink = `https://wa.me/${config.contact.whatsapp.replace(/[^0-9]/g, '')}`;
const telLink = `tel:${config.contact.telefono.replace(/\s/g, '')}`;
const mailLink = `mailto:${config.contact.email}`;
---

<footer
  id="contatti"
  class="border-t border-[var(--color-border)] bg-[var(--color-bg-alt)] px-5 py-16 sm:px-8"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <h3
          class="font-[family-name:var(--font-display)] text-2xl font-semibold"
        >
          {config.brand.name}
        </h3>
        <p class="mt-3 max-w-xs text-sm text-[var(--color-text-muted)]">
          {config.brand.tagline}
        </p>
        <div class="mt-6 flex gap-4">
          {socials.map(([key, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="text-sm text-[var(--color-text-muted)] underline-offset-4 hover:underline"
            >
              {socialLabels[key] ?? key}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-[var(--color-text-muted)]">
          Orari
        </h4>
        <ul class="mt-4 space-y-1.5 text-sm">
          {config.hours.settimana.map((d) => (
            <li class="flex justify-between gap-4">
              <span class="text-[var(--color-text-muted)]">{dayLabels[d.giorno]}</span>
              <span>
                {d.chiuso
                  ? 'Chiuso'
                  : `${d.apertura} – ${d.chiusura}`}
              </span>
            </li>
          ))}
        </ul>
        {config.hours.chiusureStraordinarie.length > 0 && (
          <p class="mt-4 text-xs text-[var(--color-text-muted)]">
            Chiusure straordinarie: {config.hours.chiusureStraordinarie.join(', ')}
          </p>
        )}
      </div>

      <div>
        <h4 class="text-xs font-medium uppercase tracking-widest text-[var(--color-text-muted)]">
          Contatti
        </h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li>{config.contact.indirizzo}</li>
          <li>
            <a href={telLink} class="hover:underline">{config.contact.telefono}</a>
          </li>
          <li>
            <a href={waLink} target="_blank" rel="noopener" class="hover:underline">
              WhatsApp: {config.contact.whatsapp}
            </a>
          </li>
          <li>
            <a href={mailLink} class="hover:underline">{config.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-2 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-text-muted)] sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} {config.brand.name}. Tutti i diritti riservati.</p>
      <p>P.IVA {config.contact.partitaIva}</p>
    </div>
  </div>
</footer>
