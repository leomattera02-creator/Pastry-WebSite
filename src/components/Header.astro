---
import type { SiteConfig } from '../config/types';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const { brand, nav } = config as SiteConfig & { nav?: { label: string; href: string }[] };

const navItems =
  nav ?? [
    { label: 'Home', href: '#top' },
    { label: 'Prodotti', href: '#prodotti' },
    { label: 'Galleria', href: '#galleria' },
    { label: 'Contatti', href: '#contatti' },
  ];

const waLink = `https://wa.me/${config.contact.whatsapp.replace(/[^0-9]/g, '')}`;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,padding] duration-300"
  data-header
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
    <a
      href="#top"
      class="font-[family-name:var(--font-display)] text-lg font-semibold tracking-tight sm:text-xl"
      data-header-logo
    >
      {brand.name}
    </a>

    <nav class="hidden gap-8 md:flex" aria-label="Navigazione principale">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm tracking-wide text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={waLink}
      target="_blank"
      rel="noopener"
      class="hidden rounded-[var(--radius-full)] bg-[var(--color-accent)] px-5 py-2 text-sm font-medium text-[var(--color-accent-fg)] transition-opacity hover:opacity-90 md:inline-block"
    >
      {config.hero.ctaSecondaria}
    </a>

    <button
      type="button"
      class="flex h-10 w-10 items-center justify-center md:hidden"
      aria-label="Apri menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span
        class="relative block h-4 w-6"
        data-menu-icon
      >
        <span class="absolute left-0 top-0 h-0.5 w-6 bg-[var(--color-text)] transition-transform duration-300" data-bar-top></span>
        <span class="absolute left-0 top-1.5 h-0.5 w-6 bg-[var(--color-text)] transition-opacity duration-300" data-bar-mid></span>
        <span class="absolute left-0 top-3 h-0.5 w-6 bg-[var(--color-text)] transition-transform duration-300" data-bar-bot></span>
      </span>
    </button>
  </div>

  <div
    class="fixed inset-0 z-40 flex flex-col bg-[var(--color-bg)] px-6 pb-8 pt-24 transition-[opacity,visibility] duration-300 md:hidden"
    data-menu-panel
    style="opacity:0;visibility:hidden;"
  >
    <nav class="flex flex-col gap-6" aria-label="Menu mobile">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class="font-[family-name:var(--font-display)] text-3xl font-medium"
          data-menu-item
          style={`--i:${i}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href={waLink}
      target="_blank"
      rel="noopener"
      class="mt-8 rounded-[var(--radius-full)] bg-[var(--color-accent)] px-6 py-3 text-center text-base font-medium text-[var(--color-accent-fg)]"
    >
      {config.hero.ctaSecondaria}
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const iconTop = document.querySelector<HTMLElement>('[data-bar-top]');
  const iconMid = document.querySelector<HTMLElement>('[data-bar-mid]');
  const iconBot = document.querySelector<HTMLElement>('[data-bar-bot]');
  const items = document.querySelectorAll<HTMLElement>('[data-menu-item]');

  let open = false;

  function setSolid(isSolid: boolean): void {
    if (!header) return;
    if (isSolid) {
      header.style.backgroundColor = 'var(--color-bg)';
      header.style.backdropFilter = 'blur(10px)';
      header.style.borderBottom = '1px solid var(--color-border)';
      header.style.paddingTop = '0';
      header.style.paddingBottom = '0';
    } else {
      header.style.backgroundColor = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.borderBottom = 'none';
    }
  }

  function onScroll(): void {
    setSolid(window.scrollY > 80);
  }

  function toggleMenu(force?: boolean): void {
    open = force ?? !open;
    if (!panel || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.style.opacity = open ? '1' : '0';
    panel.style.visibility = open ? 'visible' : 'hidden';
    if (iconTop && iconBot && iconMid) {
      iconTop.style.transform = open ? 'rotate(45deg) translateY(6px)' : '';
      iconMid.style.opacity = open ? '0' : '1';
      iconBot.style.transform = open ? 'rotate(-45deg) translateY(-6px)' : '';
    }
    if (open) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      items.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        el.style.transition = reduced
          ? 'none'
          : 'opacity 0.5s, transform 0.5s';
      });
      let delay = 0;
      items.forEach((el) => {
        window.setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }, reduced ? 0 : delay);
        delay += 70;
      });
    }
  }

  function setup(): void {
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    toggle?.addEventListener('click', () => toggleMenu());
    items.forEach((el) =>
      el.addEventListener('click', () => toggleMenu(false)),
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', () => {
    document
      .querySelector<HTMLButtonElement>('[data-menu-toggle]')
      ?.addEventListener('click', () => toggleMenu());
    onScroll();
  });
</script>
